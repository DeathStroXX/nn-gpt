{
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {
    "name": "nngpt-baseline-ga-benchmark-imagenet100"
  },
  "spec": {
    "parallelism": 1,
    "ttlSecondsAfterFinished": 86400,
    "template": {
      "spec": {
        "tolerations": [
          {
            "key": "dgx",
            "operator": "Exists"
          }
        ],
        "containers": [
          {
            "name": "ml",
            "image": "abrainone/ai-linux:cu12.6.3-latest",
            "imagePullPolicy": "Always",
            "command": [
              "/bin/bash",
              "-c"
            ],
            "args": [
              "cd /a/mm && (pip uninstall -y flash-attn || true) && pip install \"torchao==0.15.0\" kagglehub --upgrade --extra-index-url https://download.pytorch.org/whl/cu126 && pip install git+https://github.com/ABrain-One/nn-dataset --no-deps --upgrade && export PYTHONPATH=/a/mm && site_pkg=$(python3 -c 'import site; print(site.getusersitepackages())') && mkdir -p /a/mm/ab/nn && cp -r --update=none $site_pkg/ab/nn/* /a/mm/ab/nn/ || true && export RUN_TS=$(date +%Y-%m-%d_%H-%M-%S) && mkdir -p /a/mm/ab/gpt/brute/ga/meta_evolution/logs_imagenet100 && python3 -u -m ab.gpt.brute.ga.meta_evolution.meta_evolver_baseline_imagenet100 2>&1 | tee /a/mm/ab/gpt/brute/ga/meta_evolution/logs_imagenet100/baseline_pod_imagenet100_${RUN_TS}.log"
            ],
            "env": [
              {
                "name": "HF_HOME",
                "value": "/a/mm/.cache/huggingface"
              },
              {
                "name": "PIP_CACHE_DIR",
                "value": "/a/mm/.cache/pip"
              },
              {
                "name": "POPULATION_SIZE",
                "value": "20"
              },
              {
                "name": "GENERATIONS",
                "value": "30"
              },
              {
                "name": "MUTATION_RATE",
                "value": "0.6"
              }
            ],
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "runAsUser": 1017,
              "runAsGroup": 1376
            },
            "resources": {
              "requests": {
                "nvidia.com/gpu": 1,
                "cpu": 10,
                "memory": "48Gi"
              },
              "limits": {
                "nvidia.com/gpu": 1,
                "cpu": 10,
                "memory": "48Gi"
              }
            },
            "volumeMounts": [
              {
                "mountPath": "/dev/shm",
                "name": "shm"
              },
              {
                "mountPath": "/a/mm",
                "name": "v0"
              },
              {
                "mountPath": "/a/mm/data",
                "name": "v1"
              }
            ]
          }
        ],
        "restartPolicy": "Never",
        "volumes": [
          {
            "name": "shm",
            "emptyDir": {
              "medium": "Memory",
              "sizeLimit": "16Gi"
            }
          },
          {
            "name": "v0",
            "hostPath": {
              "path": "/shared/ssd/home/b-a-singh/Thesis/clone4/nn-gpt",
              "type": "Directory"
            }
          },
          {
            "name": "v1",
            "hostPath": {
              "path": "/shared/local/data/a-group-automl/data",
              "type": "Directory"
            }
          }
        ]
      }
    }
  }
}